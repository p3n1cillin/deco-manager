{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deco Manager",
  "version": "0.2.0",
  "identifier": "com.local.decomanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Deco Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main",
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}